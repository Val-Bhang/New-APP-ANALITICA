rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Note: Firestore rules evaluate with logical OR across all matching blocks.
    // Explicit allow conditions grant access; this catch-all documents that no untargeted collection is opened.
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSpectrumRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'compoundName', 'primaryFunctionalGroup', 'yUnit', 'dataPointsJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'userEmail', 'compoundName', 'primaryFunctionalGroup', 'secondaryFunctionalGroups', 'chemicalFormula', 'casNumber', 'sampleState', 'instrument', 'resolution', 'notes', 'fileName', 'fileType', 'yUnit', 'dataPointsJson', 'peaksJson', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128 && data.userEmail == request.auth.token.email))
        && data.compoundName is string && data.compoundName.size() >= 1 && data.compoundName.size() <= 200
        && data.primaryFunctionalGroup is string && data.primaryFunctionalGroup.size() >= 2 && data.primaryFunctionalGroup.size() <= 100
        && (!('secondaryFunctionalGroups' in data) || (data.secondaryFunctionalGroups is string && data.secondaryFunctionalGroups.size() <= 300))
        && (!('chemicalFormula' in data) || (data.chemicalFormula is string && data.chemicalFormula.size() <= 60))
        && (!('casNumber' in data) || (data.casNumber is string && data.casNumber.size() <= 50))
        && (!('sampleState' in data) || (data.sampleState is string && data.sampleState.size() <= 100))
        && (!('instrument' in data) || (data.instrument is string && data.instrument.size() <= 150))
        && (!('resolution' in data) || (data.resolution is string && data.resolution.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 255))
        && (!('fileType' in data) || (data.fileType is string && data.fileType.size() <= 30))
        && data.yUnit is string && (data.yUnit == 'transmittance' || data.yUnit == 'absorbance')
        && data.dataPointsJson is string && data.dataPointsJson.size() <= 500000
        && (!('peaksJson' in data) || (data.peaksJson is string && data.peaksJson.size() <= 50000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    match /spectrums/{spectrumId} {
      allow get: if isSignedIn() && isValidId(spectrumId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerified()
        && isValidId(spectrumId)
        && spectrumId == incoming().id
        && isValidSpectrumRecord(incoming());

      allow update: if isVerified()
        && isValidId(spectrumId)
        && existing().userId == request.auth.uid
        && isValidSpectrumRecord(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;

      allow delete: if isVerified()
        && isValidId(spectrumId)
        && existing().userId == request.auth.uid;
    }
  }
}
